# --- Digiseller / GGsel ---
# ID продавца и API-ключ: my.digiseller.com -> Настройки -> API ключи
DS_SELLER_ID=1
DS_API_KEY=test
# Секрет для подписи seller-sells (если отличается от API-ключа)
DS_SECRET=

# --- FazerCards ---
# API-ключ реселлера из личного кабинета
FZ_API_KEY=test

# --- Поведение ---
POLL_INTERVAL=60          # как часто опрашивать продажи, секунд
ORDER_WAIT_TTL=1800       # сколько ждать выполнения заказа у Fazer
MAX_ATTEMPTS=20           # после стольких ошибок заказ помечается error

# --- Уведомления в Telegram (необязательно) ---
TG_TOKEN=
TG_CHAT=
				


